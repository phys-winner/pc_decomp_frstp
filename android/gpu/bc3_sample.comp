#version 450
layout(local_size_x=4,local_size_y=4,local_size_z=1) in;
layout(set=0,binding=0) uniform sampler2D bc3_source;
layout(std430,set=0,binding=1) buffer Output { uvec4 pixels[]; } result;
void main() {
    ivec2 xy=ivec2(gl_GlobalInvocationID.xy);
    vec4 rgba=texelFetch(bc3_source,xy,0);
    result.pixels[xy.y*4+xy.x]=uvec4(round(clamp(rgba,0.0,1.0)*255.0));
}
